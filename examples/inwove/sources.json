{
 "run": {
  "name": "inwove",
  "date": "2026-11-09",
  "protocol_version": "0.1.0",
  "sources_dir": "sources",
  "models": {
   "coordinator": "opus",
   "lead": "opus",
   "reader": "sonnet",
   "builder": "sonnet",
   "helper_build": "sonnet",
   "helper_check": "haiku"
  }
 },
 "target": {
  "name": "InWove",
  "description": "a room server where people and their AI agents talk, propose and vote, with a signed public log",
  "url": "https://inwove.org",
  "repository": "the InWove room's repository",
  "commit_read": "c4db8b10977efa92f3f9f6364dde7a0f159b5a1a",
  "main_when_building": "49278fa",
  "goal": "InWove works for real with every project listed here: end-to-end encrypted, decentralized, with no host in the middle holding people's keys.",
  "done_test": [
   "Private notebooks live in sealed rooms on a host the room does not run, and the shared talk lives in an encrypted community room.",
   "A real person signs up from a wallet with keys they hold, gets a membership pass and enters the encrypted room.",
   "Members of two different projects read each other in one MLS group.",
   "The public log verifies with the room's server off.",
   "The room's DID is on a permanent domain.",
   "Agents keep working a full day with all of it in use."
  ],
  "rules": [
   "Plain JavaScript ES modules, Node 22, no build step.",
   "Code shared by the browser, the server and the agent bridge uses no Node-only and no browser-only APIs.",
   "No new dependency unless the task cannot be done without it; ask first.",
   "Every write that changes the room's state is a signed document.",
   "Configuration and secrets come only from the environment, documented in .env.example and the README.",
   "No personal names, accounts, tokens or private addresses in code, tests, docs or commits.",
   "Test members and test keys only; where a choice would put a key or a decision on whoever hosts the room, leave it with the person.",
   "Limits say what they protect. Logs and counters hold no content.",
   "Build the measurement with the thing: something a person or agent can read that shows it working or failing, and why."
  ],
  "needs_a_person": [
   "rules.json",
   "package.json",
   "package-lock.json",
   ".github/",
   "sandbox/",
   "src/shared/rules.js",
   "src/shared/guard.js",
   "src/shared/types.js",
   "src/shared/chain.js",
   "src/shared/did.js",
   "src/shared/crypto.js",
   "src/server/actions.js",
   "src/server/log.js",
   "src/server/hosted.js",
   "src/server/never.js",
   "src/server/drafts.js"
  ],
  "out_of_scope": [
   "running, building or installing any other project's code",
   "pushing to any other project's repository",
   "anything for projects other than the room"
  ],
  "commit_author": {
   "name": "InWove contributors",
   "email": "contributors@inwove.invalid"
  },
  "test_command": "npm test",
  "single_test_command": "node --test test/<file>.test.js",
  "security_reviewer": "a separate security reviewer, who answers the shape of a change before its code is written"
 },
